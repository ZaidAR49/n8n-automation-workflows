    {
      "parameters": {
        "jsCode": "return $input.all().filter(item => {\n  // Keep only items with an end_date (temporary promotions)\n  if (item.json.end_date === \"N/A\") return false;\n\n  // Extract the numeric value from the worth string (e.g., \"$19.99\" -> 19.99)\n  const worthString = item.json.worth || \"$0\";\n  const worthValue = parseFloat(worthString.replace(/[^0-9.]/g, ''));\n\n  // Keep only items worth more than $10\n  return worthValue > 10;\n});"
      },
