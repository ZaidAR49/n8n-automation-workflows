    {
      "parameters": {
        "jsCode": "const sheetData = $('Get row(s) in sheet').all();\nconst apiGames = $('Filter').all();\n\n// 1. Build a set of existing IDs from Google Sheet column \"ID\"\nconst existingIds = new Set(\n  sheetData.map(row => String(row.json.ID || '').trim())\n);\n\n// 2. Return ONLY games whose API `id` is NOT in the sheet\nreturn apiGames.filter(item => {\n  const gameId = String(item.json.id || '').trim();\n  return gameId !== '' && !existingIds.has(gameId);\n});"
      },
