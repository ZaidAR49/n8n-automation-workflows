    {
      "parameters": {
        "jsCode": "const message = $json.message || {};\nconst text = message.text || '';\nconst entities = message.entities || [];\n\nlet extractedUrl = null;\n\n// Find URL entity (raw text or hyperlink)\nconst urlEntity = entities.find(e => e.type === 'url' || e.type === 'text_link');\n\nif (urlEntity) {\n  if (urlEntity.type === 'text_link') {\n    extractedUrl = urlEntity.url;\n  } else if (urlEntity.type === 'url') {\n    extractedUrl = text.substring(urlEntity.offset, urlEntity.offset + urlEntity.length);\n  }\n} else {\n  // Fallback to text match if no entity exists\n  const match = text.match(/https?:\\/\\/[^\\s]+/i);\n  if (match) extractedUrl = match[0];\n}\n\n// Validate YouTube format and extract video ID\nconst ytRegex = /(?:youtube\\.com\\/(?:watch\\?v=|embed\\/|shorts\\/|live\\/)|youtu\\.be\\/)([a-zA-Z0-9_-]{11})/i;\nconst ytMatch = extractedUrl ? extractedUrl.match(ytRegex) : null;\n\nreturn {\n  json: {\n    isValid: Boolean(ytMatch),\n    youtubeUrl: ytMatch ? `https://www.youtube.com/watch?v=${ytMatch[1]}` : null\n  }\n};"
      },
