    {
      "parameters": {
        "jsCode": "const BOT_USERNAME = 'zaidinfo_bot'.toLowerCase();\n\nconst output = [];\n\nfor (const item of $input.all()) {\n  const msg = item.json.message || item.json.channel_post || item.json;\n  const text = msg.text || msg.caption || '';\n  \n  // 1. Reply / Quote Detection\n  const replyTo = msg.reply_to_message || null;\n  const quote = msg.quote || null; \n  const externalReply = msg.external_reply || null;\n\n  let replyText = null;\n  if (quote && quote.text) {\n    replyText = quote.text;\n  } else if (replyTo) {\n    replyText = replyTo.text || replyTo.caption || null;\n  }\n\n  // 2. Mention & Command Detection\n  let isBotMentioned = text.toLowerCase().includes(`@${BOT_USERNAME}`);\n  const entities = msg.entities || msg.caption_entities || [];\n  if (!isBotMentioned && entities.length > 0) {\n    isBotMentioned = entities.some(e => \n      (e.type === 'mention' || e.type === 'bot_command') && \n      text.substring(e.offset, e.offset + e.length).toLowerCase().includes(BOT_USERNAME)\n    );\n  }\n\n  const hasReportCommand = text.toLowerCase().includes('/report');\n  const isReply = replyTo !== null || quote !== null || externalReply !== null;\n  const isReport = isBotMentioned && isReply && hasReportCommand;\n\n  // --- UPDATED: Question Detection & Cleanup ---\n  // A question is any message mentioning the bot that is NOT a report\n  const isQuestion = isBotMentioned && !isReport;\n  \n  let questionText = null;\n  if (isQuestion) {\n    questionText = text\n      .replace(new RegExp(`@${BOT_USERNAME}`, 'gi'), '') // Removes the bot mention\n      .trim(); // Cleans up extra spaces\n  }\n\n  // 3. Offender Info (Mike)\n  let offenderId = null, offenderName = null, offenderUsername = null;\n  if (replyTo && replyTo.from) {\n    offenderId = replyTo.from.id;\n    offenderName = replyTo.from.first_name;\n    offenderUsername = replyTo.from.username;\n  } else if (externalReply && externalReply.origin && externalReply.origin.sender_user) {\n    offenderId = externalReply.origin.sender_user.id;\n    offenderName = externalReply.origin.sender_user.first_name;\n    offenderUsername = externalReply.origin.sender_user.username;\n  }\n\n  // 4. New Member Detection\n  const newMembers = msg.new_chat_members || (msg.new_chat_participant ? [msg.new_chat_participant] : []);\n  const isNewMember = newMembers.length > 0;\n  \n  const firstNewMember = isNewMember ? newMembers[0] : null;\n  const newMemberId = firstNewMember ? firstNewMember.id : null;\n  const newMemberName = firstNewMember \n    ? `${firstNewMember.first_name || ''} ${firstNewMember.last_name || ''}`.trim() \n    : null;\n  const newMemberUsername = firstNewMember ? firstNewMember.username || null : null;\n  const isNewMemberBot = firstNewMember ? Boolean(firstNewMember.is_bot) : false;\n\n  // 5. Final Output Object\n  output.push({\n    json: {\n      // Logic Flags\n      isBotMentioned: isBotMentioned,\n      isReply: isReply,\n      hasReportCommand: hasReportCommand,\n      isReport: isReport,\n      isNewMember: isNewMember,\n      isQuestion: isQuestion,\n\n      // Messages\n      messageText: text,\n      replyText: replyText,\n      questionText: questionText,\n\n      // Reporter Details\n      reporterId: msg.from ? msg.from.id : null,\n      reporterName: msg.from ? msg.from.first_name : null,\n      reporterUsername: msg.from ? msg.from.username : null,\n\n      // Offender Details\n      offenderId: offenderId,\n      offenderName: offenderName,\n      offenderUsername: offenderUsername,\n\n      // New Member Details\n      newMemberId: newMemberId,\n      newMemberName: newMemberName,\n      newMemberUsername: newMemberUsername,\n      isNewMemberBot: isNewMemberBot,\n\n      // Chat & Identifiers\n      chatId: msg.chat ? msg.chat.id : null,\n      messageId: msg.message_id || null,\n      replyMessageId: replyTo ? replyTo.message_id : null\n    }\n  });\n}\n\nreturn output;"
      },
